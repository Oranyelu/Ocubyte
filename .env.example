# ====================================================================
# OCUBYTE PAYMENT GATEWAY & SUPABASE BACKEND CONFIGURATION (.env)
# ====================================================================

# 1. PAYSTACK PUBLIC KEY (Client-Side)
# Starts with pk_test_ (for test mode) or pk_live_ (for production)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_actual_paystack_public_key

# 2. PAYSTACK SECRET KEY (Server-Side Only)
# Starts with sk_test_ (for test mode) or sk_live_ (for production)
PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_secret_key

# 3. GATEWAY CRYPTOGRAPHIC SIGNING SECRET (Used to authenticate OBEAG and affiliate apps)
GATEWAY_SIGNING_SECRET=generate_a_random_32_character_string_here
OCUBYTE_SECRET_KEY=sk_live_your_actual_paystack_secret_key

# 4. SUPABASE & PRISMA POSTGRESQL BACKEND CONFIGURATION
DATABASE_URL="postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Found in Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side service role key (Never expose to frontend, used in serverless API routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 5. HUMAN SETTLEMENT NOTIFICATION EMAIL (For Merchant Manual Payouts)
# The email address that receives notifications when a merchant requests a withdrawal
SETTLEMENT_NOTIFICATION_EMAIL=admin@ocubyte.org
# Optional Resend API Key for automatic email delivery (e.g. re_123456789)
RESEND_API_KEY=re_your_resend_api_key

# 6. AFFILIATE WEBHOOK DESTINATIONS
OBEAG_WEBHOOK_URL=https://ohabuenyi.vercel.app/api/ocubyte/webhook
